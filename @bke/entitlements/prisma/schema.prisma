datasource db {
  provider = "postgresql"
}

enum EntitlementStatus {
  ACTIVE
  REVOKED
}

model Entitlement {
  id              String            @id
  subjectId       String
  resourceId      String
  sourceReference String            @unique
  status          EntitlementStatus @default(ACTIVE)
  quantity        Int
  scopeSnapshot   Json
  grantSnapshot   Json
  validFrom       DateTime
  validUntil      DateTime?
  revokedAt       DateTime?
  revocationReference String?
  revocationSnapshot Json?
  createdAt       DateTime          @default(now())

  @@index([subjectId, status])
  @@index([resourceId, status])
  @@index([validUntil])
  @@index([revocationReference])
}
