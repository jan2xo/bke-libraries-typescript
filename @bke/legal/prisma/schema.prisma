datasource db {
  provider = "postgresql"
}

model LegalDocument {
  id                        String                @id
  documentType              String                @unique
  title                     String
  slug                      String                @unique
  status                    String                @default("ACTIVE")
  currentPublishedVersionId String?
  currentPublishedVersion   LegalDocumentVersion? @relation("CurrentPublishedLegalVersion", fields: [currentPublishedVersionId], references: [id], onDelete: Restrict)
  createdAt                 DateTime              @default(now())
  updatedAt                 DateTime              @updatedAt
}

model LegalDocumentVersion {
  id                    String            @id
  documentId            String
  version               String
  name                  String?
  slug                  String?
  markdownContent       String
  sha256                String
  slaVersion            String
  status                String            @default("DRAFT")
  requiresReacceptance  Boolean           @default(false)
  publishedAt           DateTime?
  createdById           String
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  acceptances           LegalAcceptance[]
  currentForDocuments   LegalDocument[]   @relation("CurrentPublishedLegalVersion")

  @@unique([documentId, version])
  @@index([documentId, createdAt])
  @@index([status, publishedAt])
}

model LegalAcceptance {
  id                    String               @id
  principalId           String
  customerAccountId     String?
  documentId            String
  documentVersionId     String
  acceptanceContext     String
  slaVersion            String
  renderedContentSha256 String
  variablesSnapshot     Json
  ipAddress             String?
  userAgent             String?
  acceptedAt            DateTime             @default(now())
  documentVersion       LegalDocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  @@index([principalId, acceptedAt])
  @@index([customerAccountId, acceptedAt])
  @@index([documentId, documentVersionId])
  @@index([principalId, customerAccountId, documentVersionId, acceptanceContext])
}
