{
  "name": "@bke/notifications",
  "version": "0.1.0",
  "description": "Reusable BKE transport-neutral notification intent capability library",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "files": [
    "contracts",
    "logic",
    "docs",
    "module.manifest.ts",
    "README.md"
  ],
  "exports": {
    "./contracts/*": "./contracts/*.ts",
    "./logic/*": "./logic/*.ts",
    "./module.manifest": "./module.manifest.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run tests/*.test.ts"
  }
}
