{
  "name": "@bke/privacy",
  "version": "0.2.0",
  "description": "Reusable BKE privacy-request lifecycle, mutation-intent, and customer minimization policy",
  "type": "module",
  "engines": { "node": ">=22.12.0" },
  "files": ["contracts", "logic", "module.manifest.ts", "README.md"],
